<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers/generators MUST target netstandard2.0 (the Roslyn host runtime). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Shipped INSIDE DynamicQuery.Core's nupkg (analyzers/dotnet/cs), not as its own package. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8.0 = the Roslyn that ships with the .NET 8 SDK / VS 17.8; has ForAttributeWithMetadataName.
         PrivateAssets=all so the Roslyn assemblies are NOT a transitive dependency of consumers. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
