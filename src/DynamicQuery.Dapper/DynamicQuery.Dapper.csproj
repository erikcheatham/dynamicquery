<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <PackageId>DynamicQuery.Dapper</PackageId>
    <Version>0.2.0</Version>
    <Authors>Erik Cheatham</Authors>
    <Description>Dapper execution layer for DynamicQuery: IDbConnection.QueryProjectionAsync&lt;T&gt; extensions that compose DynamicQuery.Core's attribute-driven SELECT/FROM into Dapper queries. Server-side companion to the dependency-free DynamicQuery.Core.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/erikcheatham/dynamicquery</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erikcheatham/dynamicquery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dapper;sql;dto;projection;postgres;jsonb;attributes</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicQuery.Core\DynamicQuery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
